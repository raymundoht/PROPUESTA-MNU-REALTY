# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a GitHub.

# URL pública del sitio (para enlaces de WhatsApp, SEO y sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuente de datos: "demo" (datos de ejemplo) o "postgres" (Fase 2)
DATA_SOURCE=demo

# Modo demo: tu propio número para probar los botones de WhatsApp (formato 521XXXXXXXXXX, sin +)
DEMO_WHATSAPP_NUMBER=

# Datos de contacto de la empresa
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Google Maps Embed API (clave PÚBLICA, restringida por dominio en Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Fase 2 (solo servidor, nunca con prefijo NEXT_PUBLIC_) ---
# DATABASE_URL=postgres://usuario:contraseña@host.rds.amazonaws.com:5432/mnu?sslmode=require
# AWS_REGION=
# S3_BUCKET=
# AUTH_SECRET=
